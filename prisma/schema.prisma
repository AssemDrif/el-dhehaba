// schema.prisma — El Dhehaba (الذهابة) Jewelry POS
// SQLite-compatible schema (no enums — stored as String)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// 1. Master Rate Configuration (Soum El Youm / السوم اليومي)
// GoldOrigin values: LOCAL | TURKISH | ITALIAN | IMPORTED
// ItemCategory values: BAGUE | ALLIANCE | BRACELET | COLLIER | BOUCLES | PARURE | DEMI_PARURE | LOUISA | OTHER
// ItemCondition values: NEUF | BONNE_OCCASION | CASSE_FONTE
// TransactionType values: SALE | BUY_CASSE | TABDIL

model GoldRateConfig {
  id                String   @id @default(cuid())
  karat             Int      @default(18)

  standardNewPrice  Float    // DZD per gram — سوم الجديد
  laCasseBuyPrice   Float    // DZD per gram — سوم شراء الكاس
  laCasseSellPrice  Float    // DZD per gram — سوم بيع الكاس

  updatedBy         String   @default("owner")
  createdAt         DateTime @default(now())
  isActive          Boolean  @default(true)
}

// 2. Jewelry Inventory Item
model JewelryItem {
  id            String   @id @default(cuid())
  sku           String   @unique
  name          String
  category      String   // BAGUE | ALLIANCE | BRACELET | COLLIER | BOUCLES | PARURE | DEMI_PARURE | LOUISA | OTHER
  origin        String   @default("LOCAL")   // LOCAL | TURKISH | ITALIAN | IMPORTED
  condition     String   @default("NEUF")    // NEUF | BONNE_OCCASION | CASSE_FONTE
  karat         Int      @default(18)

  grossWeight   Float
  stoneWeight   Float    @default(0)
  netGoldWeight Float

  faconPerGram  Float    @default(0)
  faconFixed    Float    @default(0)

  attributes    String?  // JSON blob: ringSize, bangleSize, stones, length…
  inStock       Boolean  @default(true)
  createdAt     DateTime @default(now())

  transactionItems TransactionItem[]
}

// 3. Transaction Header
model Transaction {
  id                String   @id @default(cuid())
  type              String   // SALE | BUY_CASSE | TABDIL

  appliedNewRate    Float
  appliedCasseRate  Float

  newItemsTotalDZD  Float    @default(0)
  casseTradeInDZD   Float    @default(0)
  discountDZD       Float    @default(0)
  finalPayableDZD   Float

  notes             String?
  createdAt         DateTime @default(now())

  items             TransactionItem[]
  casseItems        CasseVaultEntry[]
}

// 4. Line items within a transaction
model TransactionItem {
  id              String      @id @default(cuid())
  transaction     Transaction @relation(fields: [transactionId], references: [id])
  transactionId   String
  jewelry         JewelryItem @relation(fields: [jewelryItemId], references: [id])
  jewelryItemId   String

  quantity        Int         @default(1)
  unitPriceDZD    Float
  totalDZD        Float
}

// 5. Casse Vault — accumulated old-gold tracker (صندوق الكاس)
model CasseVaultEntry {
  id               String       @id @default(cuid())
  transaction      Transaction? @relation(fields: [transactionId], references: [id])
  transactionId    String?

  description      String?
  grossWeight      Float
  stoneDeduction   Float        @default(0)
  netGoldWeight    Float
  appliedCasseRate Float

  createdAt        DateTime     @default(now())
  sentToAffineur   Boolean      @default(false)
  sentAt           DateTime?
}

